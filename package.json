{
  "name": "comicreader",
  "version": "1.0.0",
  "description": "Cross-device comic reader with library, collections and Google Drive sync",
  "scripts": {
    "predev": "node scripts/copy-pdf-decoders.mjs",
    "prebuild": "node scripts/copy-pdf-decoders.mjs",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && gh-pages -d dist --nojekyll"
  },
  "type": "module",
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.50.0",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "private": true
}
